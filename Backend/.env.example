# Copy to Backend/.env and fill in real values. Never commit .env.

ASCEND_ENV=dev

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-database-password

# Google Gemini (https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your-api-key-here

# JWT signing key. Generate one with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-64-char-random-hex

# Optional: SELECT-only role for the AI assistant (see docs/readonly_role.sql)
# READONLY_DATABASE_URL=postgresql+psycopg2://ai_readonly:password@localhost:5432/postgres
# AI_SQL_TIMEOUT_MS=10000
